# Generated / run-time artifacts (regenerated from make_specs.py / on-cluster)
exp_*/specs/
exp_*/slurm/generated/
**/results/
**/logs/
**/__pycache__/
*.pyc

# env/ here is a CODE dir (setup_env.sh + requirements.txt), not a virtualenv;
# override the root .gitignore's 'env/' rule so it gets committed.
!env/
!env/**
